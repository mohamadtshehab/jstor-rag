{
  "manifest_version": 3,
  "name": "JSTOR RAG",
  "version": "0.1.0",
  "description": "AI-powered research assistant for JSTOR articles",
  "permissions": ["sidePanel", "activeTab", "storage"],
  "host_permissions": ["https://www.jstor.org/*", "http://localhost:8000/*"],
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.jstor.org/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "JSTOR RAG"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
