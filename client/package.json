{
  "name": "jstor-rag-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:pages -- --watch",
    "build": "npm run build:pages && npm run build:content && npm run build:worker && npm run copy:static",
    "build:pages": "vite build",
    "build:content": "vite build --config vite.content.config.ts",
    "build:worker": "vite build --config vite.worker.config.ts",
    "copy:static": "cp manifest.json dist/ && cp -r public/icons dist/ 2>/dev/null || true"
  },
  "dependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.2.1",
    "@types/chrome": "^0.1.37",
    "svelte": "^5.53.7",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
